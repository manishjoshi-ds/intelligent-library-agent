rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow blanket user listing for privacy
      allow create: if isOwner(userId) && isValidId(userId)
                    && incoming().uid == userId
                    && incoming().email is string
                    && incoming().email.size() <= 150;
      allow update: if isOwner(userId) && isValidId(userId)
                    && incoming().uid == userId
                    && incoming().email == existing().email; // Immutable email
      allow delete: if isOwner(userId);
    }

    // Saved routes & collection missions
    match /saved_routes/{routeId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(routeId)
                    && incoming().userId == request.auth.uid
                    && incoming().title is string && incoming().title.size() <= 120
                    && incoming().algorithm is string && incoming().algorithm.size() <= 50
                    && incoming().path is list && incoming().path.size() <= 100;
      allow update: if isSignedIn() && isValidId(routeId)
                    && existing().userId == request.auth.uid
                    && incoming().userId == request.auth.uid
                    && incoming().title is string && incoming().title.size() <= 120;
      allow delete: if isSignedIn() && isValidId(routeId)
                    && existing().userId == request.auth.uid;
    }
  }
}
